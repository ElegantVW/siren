[Unit]
Description=Siren HEOS DHCPv4 helper on enp39s0
After=systemd-networkd.service sys-subsystem-net-devices-enp39s0.device
Wants=sys-subsystem-net-devices-enp39s0.device

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /home/evenweaker/siren/scripts/siren-heos-dhcpd.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
