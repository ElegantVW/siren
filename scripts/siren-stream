#!/usr/bin/env python3
"""siren-stream: PipeWire/Pulse monitor -> PCM HTTP for HEOS.

Usage: siren-stream [port] [monitor]
  Defaults: port 8899, monitor <default-sink>.monitor
Endpoints:
  /siren.wav   audio/wav  (s16le, 48 kHz stereo, WAV header)
  /siren.l16   audio/L16;rate=48000;channels=2  (s16be)

Small reads (~4 KiB) so the first packet is tens of ms, not seconds.
ffmpeg is killed when the client drops or this process gets SIGTERM.
"""
import os
import signal
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8899
MONITOR = sys.argv[2] if len(sys.argv) > 2 else "Siren_Master.monitor"
CHUNK = 4096

FF_COMMON = [
    "ffmpeg", "-hide_banner", "-loglevel", "error",
    "-fflags", "nobuffer", "-flags", "low_delay",
    "-probesize", "32", "-analyzeduration", "0",
    "-f", "pulse", "-fragment_size", "1920", "-i", MONITOR,
    "-ac", "2", "-ar", "48000",
]

FF_WAV = FF_COMMON + ["-f", "wav", "-"]
FF_L16 = FF_COMMON + ["-f", "s16be", "-"]

CHILDREN = []


def cleanup(*_):
    for p in list(CHILDREN):
        try:
            p.kill()
        except OSError:
            pass
    os._exit(0)


signal.signal(signal.SIGTERM, cleanup)
signal.signal(signal.SIGINT, cleanup)


class H(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        sys.stderr.write(f"siren-stream: {self.client_address[0]} {self.command} {self.path}\n")

    def _pick(self):
        if self.path.split("?", 1)[0] == "/siren.wav":
            return "audio/wav", FF_WAV
        if self.path.split("?", 1)[0] == "/siren.l16":
            return "audio/L16;rate=48000;channels=2", FF_L16
        return None, None

    def do_HEAD(self):
        mime, _ = self._pick()
        if not mime:
            self.send_response(404)
            self.end_headers()
            return
        self.send_response(200)
        self.send_header("Content-Type", mime)
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()

    def do_GET(self):
        mime, ff = self._pick()
        if not mime:
            self.send_response(404)
            self.end_headers()
            return
        self.send_response(200)
        self.send_header("Content-Type", mime)
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "close")
        self.end_headers()
        p = None
        try:
            p = subprocess.Popen(
                ff,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL,
                bufsize=0,
            )
            CHILDREN.append(p)
            while True:
                chunk = p.stdout.read(CHUNK)
                if not chunk:
                    break
                try:
                    self.wfile.write(chunk)
                    self.wfile.flush()
                except (BrokenPipeError, ConnectionResetError):
                    break
        except Exception as e:
            sys.stderr.write(f"siren-stream: client error {e}\n")
        finally:
            if p is not None:
                try:
                    p.kill()
                except OSError:
                    pass
                try:
                    CHILDREN.remove(p)
                except ValueError:
                    pass


print(f"siren-stream: {MONITOR} -> :{PORT}/siren.wav|/siren.l16 chunk={CHUNK}", flush=True)
ThreadingHTTPServer(("0.0.0.0", PORT), H).serve_forever()
