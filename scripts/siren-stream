#!/usr/bin/env python3
"""siren-stream: capture a PipeWire monitor -> ffmpeg mp3 -> HTTP live stream.
Usage: siren-stream [port] [monitor]
  Defaults: port 8899, monitor Siren_Master.monitor
Endpoint: /siren.mp3  (endless MP3, radio-style, no Content-Length)

This is the same server siren's stream.rs embeds. Kept here so it can
run standalone (systemd, nohup, debugging) without the TUI.
"""
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8899
MONITOR = sys.argv[2] if len(sys.argv) > 2 else "Siren_Master.monitor"

FF = ["ffmpeg", "-hide_banner", "-loglevel", "error",
      "-f", "pulse", "-i", MONITOR,
      "-ac", "2", "-ar", "44100",
      "-codec:a", "libmp3lame", "-b:a", "128k",
      "-f", "mp3", "-"]


class H(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        sys.stderr.write(f"siren-stream: {self.client_address[0]} {self.command} {self.path}\n")

    def do_GET(self):
        if self.path != "/siren.mp3":
            self.send_response(404)
            self.end_headers()
            return
        self.send_response(200)
        self.send_header("Content-Type", "audio/mpeg")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Connection", "close")
        self.end_headers()
        try:
            p = subprocess.Popen(FF, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            while True:
                chunk = p.stdout.read(65536)
                if not chunk:
                    break
                try:
                    self.wfile.write(chunk)
                except (BrokenPipeError, ConnectionResetError):
                    break
            p.terminate()
        except Exception as e:
            sys.stderr.write(f"siren-stream: client error {e}\n")

    def do_HEAD(self):
        if self.path != "/siren.mp3":
            self.send_response(404)
            self.end_headers()
            return
        self.send_response(200)
        self.send_header("Content-Type", "audio/mpeg")
        self.end_headers()


print(f"siren-stream: {MONITOR} -> :{PORT}/siren.mp3", flush=True)
ThreadingHTTPServer(("0.0.0.0", PORT), H).serve_forever()
